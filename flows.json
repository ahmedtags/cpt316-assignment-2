-inactive {\n    color: #999;\n}\n.toggle-btn {\n    padding: 12px 24px;\n    border: none;\n    border-radius: 5px;\n    font-size: 14px;\n    font-weight: bold;\n    cursor: pointer;\n    min-width: 120px;\n    transition: all 0.3s;\n}\n.btn-on {\n    background: #f44336;\n    color: white;\n}\n.btn-on:hover {\n    background: #da190b;\n}\n.btn-off {\n    background: #4CAF50;\n    color: white;\n}\n.btn-off:hover {\n    background: #45a049;\n}\n</style>\n\n<div ng-repeat=\"device in msg.payload.devices\">\n    <div class=\"device-card\">\n        <div class=\"device-info\">\n            <div class=\"device-name\">{{device.name}}</div>\n            <div class=\"device-power\">Power: {{device.power}}W</div>\n            <div class=\"device-status\" ng-class=\"device.status === 'active' ? 'status-active' : 'status-inactive'\">\n                <span ng-if=\"device.status === 'active'\">● ACTIVE</span>\n                <span ng-if=\"device.status === 'inactive'\">○ INACTIVE</span>\n            </div>\n        </div>\n        <button \n            class=\"toggle-btn\"\n            ng-class=\"device.status === 'active' ? 'btn-on' : 'btn-off'\"\n            ng-click=\"send({payload: device.id})\">\n            <span ng-if=\"device.status === 'active'\">TURN OFF</span>\n            <span ng-if=\"device.status === 'inactive'\">TURN ON</span>\n        </button>\n    </div>\n</div>","storeOutMessages":true,"fwdInMessages":true,"resendOnRefresh":true,"templateScope":"local","className":"","x":550,"y":440,"wires":[["f542a92098f39df4"]]},{"id":"f542a92098f39df4","type":"http request","z":"8b6cbdc016b0f43b","name":"Toggle Device","method":"GET","ret":"txt","url":"http://localhost:5000/api/toggle/{{payload}}","x":780,"y":440,"wires":[["bd3ca1a0112e6677"]]},{"id":"bd3ca1a0112e6677","type":"delay","z":"8b6cbdc016b0f43b","name":"Wait 300ms","pauseType":"delay","timeout":"300","timeoutUnits":"milliseconds","rate":"1","nbRateUnits":"1","rateUnits":"second","randomFirst":"1","randomLas